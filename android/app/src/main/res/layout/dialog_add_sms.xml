<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Template Warning Banner (hidden by default) -->
        <LinearLayout
            android:id="@+id/template_warning_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFEB3B"
            android:padding="12dp"
            android:visibility="gone">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ SMS source is using App template"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="14sp" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This may cause placeholder variables ({{package}}, {{title}}) to appear instead of actual SMS content."
                android:textColor="#555555"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
            
            <Button
                android:id="@+id/btn_fix_template"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset to SMS Template"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FF9800" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target Phone Number"
            android:textColor="#333333"
            android:textStyle="bold" 
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/input_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="+1 555 123 4567"
                android:inputType="phone" />

            <ImageButton
                android:id="@+id/btn_pick_contact"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:contentDescription="Pick Contact"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Display Name (Optional)"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/input_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Fire Dispatch"
            android:inputType="textCapWords" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Content Filter (Optional)"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Only send if message contains:"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/input_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Alert"
            android:inputType="text" />

        <CheckBox
            android:id="@+id/check_case"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Case Sensitive"
            android:layout_marginTop="8dp"/>

        <!-- Endpoint Selection Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Endpoints (Fan-Out) *"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/text_endpoint_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="At least one ENABLED endpoint must be selected"
            android:textSize="12sp"
            android:textColor="#FF5722" />

        <LinearLayout
            android:id="@+id/container_endpoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
